{
  "name": "dsh-mimo-balance",
  "version": "1.3.0",
  "private": true,
  "description": "Xiaomi MiMo balance and usage estimates for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "REVIEW.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "install:profile": "node scripts/profile.mjs install",
    "uninstall:profile": "node scripts/profile.mjs uninstall",
    "setup:browser": "playwright install chromium",
    "check:release": "node scripts/check-release.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "playwright": "^1.64.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouchu000/dsh-mimo-balance.git"
  },
  "homepage": "https://github.com/zhouchu000/dsh-mimo-balance#readme",
  "bugs": {
    "url": "https://github.com/zhouchu000/dsh-mimo-balance/issues"
  }
}
